# Local LLM configuration used by ./start-local.sh
#
# Providers:
#   ollama   - Ollama's OpenAI-compatible local endpoint
#   lmstudio - LM Studio's OpenAI-compatible local endpoint
#   mlx      - load a Hugging Face/MLX model directly in this process

S2S_LLM_PROVIDER=ollama
S2S_LLM_MODEL=gemma4:e4b
S2S_LLM_BASE_URL=http://127.0.0.1:11434/v1
S2S_LLM_API_KEY=ollama
S2S_LLM_REASONING_EFFORT=none

# Optional transcript-level wake word gate. When enabled, the assistant only
# responds after a final transcript contains one of these comma-separated
# phrases. The matched phrase is stripped before the text goes to the LLM.
S2S_WAKE_WORD_ENABLED=false
S2S_WAKE_WORDS="hey alice"
S2S_WAKE_WORD_STRIP=true

# Optional local Python custom tools. Definitions live in a JSON array and
# enabled scripts receive {"args": ..., "tool": ...} on stdin, then return
# plain text or JSON on stdout.
S2S_CUSTOM_TOOLS_ENABLED=false
S2S_CUSTOM_TOOLS_PATH=user-customization/custom-tools.json
S2S_CUSTOM_TOOLS_TIMEOUT_S=10

# Optional local memory. Only explicit phrases like "remember that my name is
# Ada" are stored. Remembered facts are injected into later prompts locally.
S2S_MEMORY_ENABLED=false
S2S_MEMORY_PATH=user-customization/memories.json
S2S_MEMORY_MAX_PROMPT_ITEMS=8

# Optional real lip-sync renderer. When set, the web UI collects completed
# WebSocket assistant audio, sends it as multipart/form-data to this endpoint
# through /api/lipsync, and plays the returned MP4 as the avatar response.
# The renderer should return video/mp4 bytes or JSON with {"video_url": "..."}.
# This is intentionally off by default because local Wav2Lip/MuseTalk-style
# renderers add seconds of latency and require their own model runtime.
S2S_LIPSYNC_URL=

# LM Studio example:
# S2S_LLM_PROVIDER=lmstudio
# S2S_LLM_MODEL=your-loaded-model-id
# S2S_LLM_BASE_URL=http://127.0.0.1:1234/v1
# S2S_LLM_API_KEY=lm-studio
# S2S_LLM_REASONING_EFFORT=none

# Native MLX example (must already exist in the Hugging Face cache):
# S2S_LLM_PROVIDER=mlx
# S2S_LLM_MODEL=unsloth/gemma-4-31b-it-UD-MLX-4bit
